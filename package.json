{
  "name": "node-auto-trader",
  "version": "1.0.0",
  "description": "XMR auto-trader with web-sockets on Node.JS",
  "main": "index.ts",
  "author": "Alex Gordienko <alexoid1999@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc && cp ./xmrig-ubuntu ./build/xmrig-ubuntu",
    "start": "yarn build && node build/index.js",
    "serve": "node build/index.js",
    "dev": "npx nodemon",
    "statistic": "cd statistic && yarn start",
    "lint": "eslint . --ext .ts",
    "test": "node --require ts-node/register --test test/**/*.test.ts",
    "backfill:binance": "ts-node --transpile-only src/scripts/binance-backfill.ts",
    "backtest": "MODELS_DIR=\"$PWD/src/Storage/backtest/models\" NODE_OPTIONS=\"--max-old-space-size=8192\" ts-node --transpile-only src/scripts/backtest.ts",
    "collect:stats": "ts-node --transpile-only src/scripts/collector-stats.ts",
    "features:report": "MODELS_DIR=\"$PWD/src/Storage/features-report/models\" NODE_OPTIONS=\"--max-old-space-size=8192\" ts-node --transpile-only src/scripts/features-report.ts",
    "signal:orderflow": "NODE_OPTIONS=\"--max-old-space-size=8192\" ts-node --transpile-only src/scripts/orderflow-signal.ts",
    "rebalance:backtest": "ts-node --transpile-only src/scripts/rebalance-backtest.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "@tensorflow/tfjs-node": "4.22.0",
    "@tensorflow/tfjs-node-gpu": "4.22.0",
    "@waves/waves-transactions": "^4.3.11",
    "adm-zip": "0.5.14",
    "aws-sdk": "^2.1677.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "monero-ts": "^0.9.9",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/adm-zip": "0.5.7",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.10",
    "@types/socket.io": "^3.0.2",
    "@types/ws": "^8.5.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0"
  }
}
