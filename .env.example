# Copy to .env and fill in. Secrets have no default (src/config/env.ts): an unset one throws, naming the variable,
# the first time it is actually used — not at process start. Pure data-only paths (backfills, backtests, model
# training) run with none of the secrets below set.

# --- Secrets: required only by the paths that touch funds or a signed provider ---

# ChangeNOW swap-aggregator API key. Dead code today (CryptoExchange.service.ts has no importer) — do not set
# unless you are reviving that path.
CHANGE_NOW_API=

# Infura JSON-RPC project key for the Ethereum provider (EtheriumWallet.service.ts)
INFURA_API_KEY=

BLOCK_CYPHER_API=
ZEROX_API_KEY=

# Wallet addresses funds are sent to
ETHERIUM_WALLET_ADDRESS=
WAVES_WALLET_ADDRESS=

# Wallet private keys used to sign transactions — never log these, never write them to Storage
ETHERIUM_PRIVATE_KEY=
WAVES_PRIVATE_KEY=

# DigitalOcean Spaces (digitalOcean.config.ts)
DO_KEY_ID=
DO_SECRET_KEY=
DO_SPACE_ENDPOINT=
DO_SPACE_BUCKET=

# --- Execution (src/services/execution) ---

# "paper" (default, no credential, no real swaps) or "live". "live" is rejected until BinanceSpotVenue is
# implemented (TRA-16 P1) — see ExecutionService.
EXECUTION_MODE=paper

# Signed Binance spot REST (BinanceSpotVenue.ts), only read when EXECUTION_MODE=live. Defaults to the public
# testnet (testnet.binance.vision, no real funds) — do not set BINANCE_EXECUTION_BASE_URL to a mainnet host
# until P2/P3. The private key is PKCS8 PEM; since an env file has no real newlines, paste it with literal
# "\n" in place of line breaks — the config unescapes it. Never set these to a mainnet trade key here.
BINANCE_API_KEY=
BINANCE_ED25519_PRIVATE_KEY=
BINANCE_EXECUTION_BASE_URL=
BINANCE_RECV_WINDOW_MS=5000

# --- Alerting (src/services/AlertService.ts) ---

# Optional. Slack-compatible {text} webhook. Unset: alerts are log-only, which needs no credential.
ALERT_WEBHOOK_URL=

